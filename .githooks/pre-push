#!/usr/bin/env bash
# Pre-push hook: gate publish-to-main on a recent /autodoc session.
#
# When you push to main (the deploy branch), this hook counts commits
# touching wiki/, .claude/, or raw/ since the last `chore(autodoc):`
# commit. If ≥ 2 such commits exist, the hook prompts you to run
# /autodoc before the push lands. Reply `y` to push anyway; anything
# else aborts so you can run /autodoc and re-push.
#
# The hook never runs Claude itself — git hooks can't invoke a skill.
# It only fires the reminder. Once you run /autodoc and commit the
# insights, the count resets and the next push goes through silently.
#
# Bypass: `git push --no-verify`. Don't make a habit of it.
#
# Pushes to any branch other than main pass through silently.

set -u

remote="${1:-}"
yellow=$'\033[33m'
reset=$'\033[0m'

# Detect a push to main from the refs piped on stdin.
on_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    on_main=1
  fi
done

if (( on_main == 0 )); then
  exit 0
fi

# Find the last autodoc commit.
last_autodoc=$(git log -1 --format=%H --grep '^chore(autodoc):' 2>/dev/null || true)
range="HEAD"
if [[ -n "$last_autodoc" ]]; then
  range="${last_autodoc}..HEAD"
fi

# Count substantive commits since.
substantive=$(git log "$range" --format=%H --no-merges \
  -- wiki/ .claude/ raw/ 2>/dev/null | wc -l | tr -d ' ')

if (( substantive < 2 )); then
  exit 0
fi

printf '\n%spre-push: %d substantive commit(s) since the last /autodoc on main.%s\n' \
  "$yellow" "$substantive" "$reset"
printf 'Run /autodoc to capture session insights, then re-push.\n'
printf 'Push anyway? [y/N] '

if [[ -t 0 ]]; then
  read -r answer </dev/tty || answer=""
else
  answer=""
fi

case "$answer" in
  y|Y|yes|YES)
    exit 0
    ;;
  *)
    printf '\nAborted. Run /autodoc, commit the insights, then re-push.\n'
    exit 1
    ;;
esac
